@article{tapiovaara2004,
  author  = {Tapiovaara, Markku J. and Sandborg, Michael},
  title   = {How should low-contrast detail detectability be measured in fluoroscopy?},
  journal = {Medical Physics},
  year    = {2004},
  volume  = {31},
  number  = {9},
  pages   = {2564--2576},
  doi     = {10.1118/1.1779357},
  note    = {Texte vérifié (PDF dans bibliographie/). Quatre méthodes comparées sur un même système de scopie : seuil de contraste subjectif, 2-AFC, 16-AFC et mesure physique du SNR\textsuperscript{2}\textsubscript{rate}. Résumé : « the precision and sensitivity of the threshold contrast measurement were seen to be modest in the constancy testing of fluoroscopic equipment: only large changes in system performance could be reliably detected by that method ». Écarts-types relatifs des observateurs individuels de 0 à 0,23, 75 \% entre 0,08 et 0,20. Conclusion : avec un ou deux observateurs, le seuil subjectif ne révèle que des changements « exceptionally large » si les tests sont espacés ou faits par des observateurs différents ; le nombre d'observateurs nécessaire est « impractically large » ; les méthodes MAFC souffrent aussi du grand nombre d'observations requises. Préconise le SNR\textsuperscript{2}\textsubscript{rate}, « task-dependent image quality descriptor », relié à la performance humaine par un temps d'intégration effectif (0,6 s en 2-AFC, 0,3 s en 16-AFC). Référence pivot entre « actuel » et « idéal » : la diapo peut dire « peu reproductible » pour le seuil visuel, et c'est l'origine du SNR\textsuperscript{2}rate de l'EFOMP 2024.}
}

