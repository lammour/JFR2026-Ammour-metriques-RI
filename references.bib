@techreport{iec2008,
  author      = {{International Electrotechnical Commission}},
  title       = {Medical electrical equipment -- Characteristics of digital {X}-ray imaging devices -- Part 1-3: Determination of the detective quantum efficiency -- Detectors used in dynamic imaging},
  number      = {IEC 62220-1-3:2008},
  institution = {International Electrotechnical Commission},
  address     = {Geneva},
  year        = {2008},
  url         = {https://webstore.iec.ch/en/publication/6599},
  note        = {Norme DQE « dynamique » (texte vérifié le 07/10/2026, édition EN 2009 dans bibliographie/). Clause 5 : seules corrections admises sur les RAW DATA, « linear and image-independent » : pixels défectueux, flat-field (non-uniformité du champ, offset, gain), distorsion géométrique ; tout traitement dépendant de l'image est exclu. Le lag n'est pas ignoré mais corrigé : 4.6.3 « LAG EFFECTS will be separately determined and the estimated NPS will be corrected for these effects » ; 6.3.2.2 : facteur r = rapport des intégrales de la PSD temporelle du bruit quantique (périodogramme pixel par pixel sur la séquence) à la PSD blanche ; 6.3.2.3 : seule la part quantique de la NPS est divisée par r. La DQE reste donc une DQE 2D par frame ramenée au bruit non corrélé, sans MTF ni DQE temporelle. Clause 7 : la déclaration de conformité porte sur la DQE (0,5 ; 1 ; 1,5 mm\textsuperscript{-1}… jusqu'à Nyquist) avec qualité de faisceau, kerma, cadence et facteur r ; la MTF et la NPS sont des intermédiaires (6.3.3, 6.3.2), non déclarées. Incertitude exigée : ± 0,06 ou ± 10 \%. Toujours en édition 1.0.}
}

@techreport{ansm2016,
  author      = {{Agence nationale de sécurité du médicament et des produits de santé}},
  title       = {Décision du 21 novembre 2016 fixant les modalités du contrôle de qualité des installations de radiodiagnostic utilisées pour des procédures interventionnelles radioguidées, et son guide d'application},
  number      = {Compilation version 7 du 4 août 2026},
  institution = {ANSM},
  address     = {Saint-Denis},
  year        = {2016},
  url         = {https://ansm.sante.fr},
  note        = {Texte réglementaire français du CQ en radiologie interventionnelle (texte vérifié le 07/10/2026, compilation v7 dans bibliographie/). En vigueur depuis le 31 mars 2017. Qualité image (test 6.3) : deux tests seulement, résolution à bas contraste (objet-test 18 disques de 8 mm sous 1 mm Cu, critère 9/7/8 disques selon le type, lecture visuelle à 3 diamètres d'écran, sur la dernière image mémorisée) et résolution spatiale (mire de plomb à 45°, 2,24 à 1,12 pl/mm selon le champ, dernier groupe distinguable à l'œil pendant l'exposition). Aucune mesure de MTF, NPS, DQE, ni de test sur objet mobile ni de lag. Le filtre récursif est connu du texte : 6.3.3 demande que « le nombre d'images utilisé en mode coulissant, en cas d'application d'un filtrage du bruit de type récursif, ne doit pas dépasser celui utilisé en routine », sans le mesurer. Protocoles d'acquisition et d'affichage « ceux utilisés en routine », donc images traitées. Constance : kerma, PKS, mA, kV à 25/25/20/10 \%. Débit max 100 mGy/min scopie standard, 200 haut débit.}
}

