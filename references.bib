@article{konst2021,
  author  = {Konst, Bente and N{\o}tthellen, Jacob and N{\ae}ss, Stine Nalum and B{\aa}th, Magnus},
  title   = {Novel method to determine recursive filtration and noise reduction in fluoroscopic imaging -- a comparison of four different vendors},
  journal = {Journal of Applied Clinical Medical Physics},
  year    = {2021},
  volume  = {22},
  number  = {1},
  pages   = {281--292},
  doi     = {10.1002/acm2.13115},
  note    = {Mesure de beta = 1/K (I(n) = beta S(n) + (1-beta) I(n-1), « forget factor ») par ratio de variances somme/différence sur trois images d'une série (PMMA 20 cm, gap 6 cm, séries 8--10 s ; B, C = 4e et 5e avant la fin, A au milieu, LIH exclue). Quatre arceaux mobiles (GE OEC Elite, Philips Zenition 70, Siemens Cios Alpha, Ziehm Vision RFD). Écart au nominal 0,31--1,08 \%, CV 0,58--1,48 \%. K mesurés de 1,0 à 13 ; réduction de bruit mesurée environ 0,4--0,7, inférieure à la théorie à cause du bruit de structure fixe non filtré (exception GE cine). GE réduit K quand la dose monte, Philips non ; GE et Philips augmentent K avec la cadence ; tous réduisent le filtrage appliqué à basse cadence et fort K. Beta ne distingue pas lag détecteur et filtre. Base de la manip proposée.}
}

@article{villa2026,
  author  = {Villa, Raffaele and Paruccini, Nicoletta and De Ponti, Elena},
  title   = {Multiparametric Characterisation of a Recursive Filtration Algorithm on a Commercial Angiographic Equipment},
  journal = {Journal of Imaging Informatics in Medicine},
  year    = {2026},
  doi     = {10.1007/s10278-026-02103-x},
  note    = {Published online 7 July 2026. Artis Q biplan (Monza), 7,5 i/s, grille, fantôme rotatif 30 tr/min (disques Pb 2--5 mm, fils acier 0,2/0,6 mm). Méthode de Konst (K\_noise) : K manuels 1--8 retrouvés à 8 \% près. Modes automatiques Auto 1--8 : K\_noise 1,2--3,2 sur fond uniforme, mais K cinématique (décroissance du contraste derrière l'objet mobile) 1,0--2,7, écarts jusqu'à -66 \%, décroissance en exponentielle étirée (0,24--0,78) pour 6 modes sur 8 : filtre adaptatif au mouvement. NPS temporelle : passe-bas propre pour K manuel, remontée haute fréquence pour certains modes auto. Premières 50 frames exclues.}
}


