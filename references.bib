  journal = {Physics in Medicine \& Biology},
  year    = {2021},
  volume  = {66},
  number  = {24},
  pages   = {245001},
  doi     = {10.1088/1361-6560/ac3c15},
  note    = {Frame NEQ et frame system DQE : disque Cu 0,1 mm (50 mm de diamètre) en translation rectiligne, eau solide 5--20 cm, grille, traitement activé (approximation petit signal). Cios Fusion (arceau) et Axiom Artis Zee (cardio fixe), Siemens : DQE frame 0,65 à 20 cm avec grille pour les deux ; 0,38/0,42/0,50 à 5/10/15 cm et 0,43 sans grille sur l'Artis Zee ; indépendante de la cadence, du débit de dose (dose/frame constante) et, à l'approximation près, du traitement (MTF\_t = NTF\_t = H\_t) ; NEQ frame lui aussi invariant au filtre. L'effet du filtre récursif se lit dans MTF\_t (K 1--8 sur Artis Zee). Éq. (22) = NEQ frame (c'est la formule de la diapo 25 du webinaire), éq. (23) = DQE frame. La seule DQE de la chaîne complète.}
}

@misc{viry2023,
  author       = {Viry, Ana{\"i}s},
  title        = {Évaluation de la qualité d'image d'objets en mouvement en fluoroscopie},
  howpublished = {Communication invitée, 61\textsuperscript{es} Journées scientifiques de la SFPM, session imagerie médicale, Nancy ; vidéo Canal-C2, \url{https://www.canalc2.tv/video/16383}, 26 min},
  year         = {2023},
  note         = {Équipe de Monnin (CHUV Lausanne). Vidéo, transcription automatique et captures dans bibliographie/Viry\_SFPM2023/ : les 15 diapos de résultats à la racine (nom = minutage + sujet) et la série complète des 45 diapos, états progressifs compris, dans le sous-dossier diapos/ (numéro + minutage). Deux méthodes : (1) qualitative pour arceaux mobiles, fantôme CDRAD sur plateforme mobile, courbe contraste-détail par plusieurs observateurs à 0, 2 et 10 mm/s et pour trois modes de dose (2, 3,7 et 5,6 mGy/min) : dégradation nette avec la vitesse ; jugée « subjective, éloignée d'une tâche clinique ». (2) quantitative pour salles fixes = Monnin 2021 pas à pas (disque Cu sur PMMA, MTF spatiale par bord franc statique, MTF temporelle par rapport des IRF en mouvement/statique, NPS 3D intégrée en fréquence temporelle), puis, absent de l'article, un observateur NPWE spatio-temporel : d' avec MTFxy, MTFt, filtre visuel (VTF), spectre d'un cathéter simulé (disque 1 mm, contraste du disque Cu) et NPS spatio-temporelle. Résultats sur Artis Zee : MTFt monte avec la cadence (3 à 30 i/s) et chute quand le K-factor passe de 1 à 8 ; filtre passe-bas et rehaussement de bord modifient la MTF spatiale ; la NPS spatiale baisse d'amplitude avec K sans changer de forme ; d' croît avec le débit de dose (2 à 10 mGy/min, scopie puis graphie) et chute avec la vitesse de l'objet (0 à 4 mm/s) pour deux machines à 15 et 5 i/s. Conclusion : « un système dynamique ne devrait pas être qualifié de manière statique : biais en statique en faveur des systèmes à faible résolution temporelle » ; perspectives : optimisation sur fantôme pour une tâche clinique, benchmark de systèmes. Précisions de l'oral (transcription) : « une machine à faible cadence, si on la caractérise en statique, on va avoir tendance à la surqualifier par rapport à une machine à 15 i/s, alors qu'en dynamique ces deux machines sont équivalentes » ; 600 à 800 images par mesure, exportées sans compression et avec les mêmes filtres que l'écran, accès difficile (d'où les salles fixes, avec les ingénieurs d'application) ; le d' spatio-temporel n'est pas publié, corrélation avec des observateurs humains encore à faire ; méthode appliquée à un appel d'offres (différences entre constructeurs vues, score 1--10 demandé par les biomédicaux). Question de la salle sur la NPS temporelle (images non simultanées) : réponse = elle montre la baisse de bruit due à la corrélation entre images. Utile : argument d'autorité pour le paradoxe (diapo 9), existence d'un d' spatio-temporel chez Monnin (diapo 13, citable seulement comme communication).}
}


